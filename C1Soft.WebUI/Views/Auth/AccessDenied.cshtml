@{
    ViewData["Title"] = "Erişim Engellendi";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <div class="card shadow-sm border-0 p-5">
            <div class="mb-3 text-danger">
                <i class="bi bi-shield-x" style="font-size: 4rem;"></i>
            </div>
            <h2 class="fw-bold text-dark mb-2">Erişim Yetkisi Yetersiz (403)</h2>
            <p class="text-muted mb-4">
                Bu sayfaya veya yönetim paneline erişmek için gerekli rol yetkisine sahip değilsiniz.
            </p>
            <div class="d-flex justify-content-center gap-2">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                    Ana Sayfaya Dön
                </a>
                <a asp-controller="Auth" asp-action="Login" class="btn btn-primary">
                    Farklı Hesapla Giriş Yap
                </a>
            </div>
        </div>
    </div>
</div>
