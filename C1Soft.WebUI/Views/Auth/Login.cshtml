@model C1Soft.Business.DTOs.Auth.LoginDto
@{
    ViewData["Title"] = "Bayi / Yönetici Girişi";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white text-center py-3">
                <h4 class="mb-0 fw-bold"><i class="bi bi-box-arrow-in-right me-2"></i>C1Soft B2B Platformu</h4>
                <small class="text-white-50">Bayi & Yönetici Giriş Portalı</small>
            </div>
            <div class="card-body p-4">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle me-1"></i>@TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
                    </div>
                }

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div class="alert alert-danger" role="alert">
                        <ul class="mb-0 ps-3">
                            @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        </ul>
                    </div>
                }

                <form asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="UsernameOrEmail" class="form-label fw-semibold">Kullanıcı Adı veya E-Posta</label>
                        <input asp-for="UsernameOrEmail" class="form-control" placeholder="Örn: admin veya bayi1" autofocus />
                        <span asp-validation-for="UsernameOrEmail" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold">Şifre</label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                        Giriş Yap
                    </button>
                </form>

                <div class="text-center mt-3">
                    <span class="text-muted">Hesabınız yok mu?</span>
                    <a asp-action="Register" class="text-decoration-none fw-semibold">Yeni Bayi Kaydı Oluştur</a>
                </div>
            </div>

            <!-- Case İnceleyen Test Kullanıcı Bilgileri Kartı -->
            <div class="card-footer bg-light p-3 border-top">
                <div class="small text-muted mb-1 fw-bold">
                    <i class="bi bi-info-circle me-1"></i>Test Giriş Hesapları (Case Doğrulama):
                </div>
                <div class="row g-2 small">
                    <div class="col-6">
                        <div class="p-2 bg-white rounded border">
                            <span class="badge bg-danger mb-1">Admin</span><br />
                            <strong>admin</strong> / <code>Admin123!</code>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-2 bg-white rounded border">
                            <span class="badge bg-success mb-1">Bayi</span><br />
                            <strong>bayi1</strong> / <code>Bayi123!</code>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
