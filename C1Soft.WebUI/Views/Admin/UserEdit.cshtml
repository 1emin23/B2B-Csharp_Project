@model C1Soft.Business.DTOs.User.UserEditDto
@using C1Soft.Domain.Enums
@{
    ViewData["Title"] = $"Kullanıcı Düzenle - {Model.Username}";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold"><i class="bi bi-person-gear me-2"></i>Kullanıcı / Bayi Düzenle</h5>
                <a asp-action="Users" class="btn btn-outline-light btn-sm">
                    <i class="bi bi-arrow-left me-1"></i>Listeye Dön
                </a>
            </div>
            <div class="card-body p-4">
                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div class="alert alert-danger" role="alert">
                        <ul class="mb-0 ps-3">
                            @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        </ul>
                    </div>
                }

                <form asp-action="UserEdit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="FirstName" class="form-label fw-semibold">Ad</label>
                            <input asp-for="FirstName" class="form-control" />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LastName" class="form-label fw-semibold">Soyad</label>
                            <input asp-for="LastName" class="form-control" />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Username" class="form-label fw-semibold">Kullanıcı Adı</label>
                            <input asp-for="Username" class="form-control" />
                            <span asp-validation-for="Username" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold">E-Posta</label>
                            <input asp-for="Email" type="email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PhoneNumber" class="form-label fw-semibold">Telefon</label>
                        <input asp-for="PhoneNumber" class="form-control" />
                    </div>

                    <div class="row g-3 mb-3 align-items-center">
                        <div class="col-md-6">
                            <label asp-for="Role" class="form-label fw-semibold">Yetki Rolü</label>
                            <select asp-for="Role" class="form-select">
                                <option value="@UserRole.Customer">Customer (Bayi)</option>
                                <option value="@UserRole.Admin">Admin (Yönetici)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check form-switch mt-4">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
                                <label asp-for="IsActive" class="form-check-label fw-semibold">Hesap Aktif</label>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="NewPassword" class="form-label fw-semibold">Yeni Şifre (İsteğe Bağlı)</label>
                        <input asp-for="NewPassword" type="password" class="form-control" placeholder="Değiştirmek istemiyorsanız boş bırakın" />
                        <small class="text-muted">Boş bırakılırsa kullanıcının mevcut şifresi korunur.</small>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-bold">
                        <i class="bi bi-save me-1"></i>Kullanıcıyı Güncelle
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
