@model C1Soft.Business.DTOs.Banner.BannerEditDto
@{
    ViewData["Title"] = "Slider Düzenle";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2"></i>Slider Düzenle: @Model.Title</h5>
                <a asp-action="Banners" class="btn btn-outline-light btn-sm">
                    <i class="bi bi-arrow-left me-1"></i>Listeye Dön
                </a>
            </div>
            <div class="card-body p-4">
                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div class="alert alert-danger" role="alert">
                        <ul class="mb-0 ps-3">
                            @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        </ul>
                    </div>
                }

                <form asp-action="BannerEdit" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="ExistingImageUrl" />

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold">Slider Başlığı *</label>
                        <input asp-for="Title" class="form-control" required />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Subtitle" class="form-label fw-semibold">Alt Başlık / Açıklama Metni</label>
                        <textarea asp-for="Subtitle" rows="2" class="form-control"></textarea>
                        <span asp-validation-for="Subtitle" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-8">
                            <label asp-for="RedirectUrl" class="form-label fw-semibold">Tıklanınca Gidilecek Link (URL)</label>
                            <input asp-for="RedirectUrl" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="OrderIndex" class="form-label fw-semibold">Gösterim Sırası *</label>
                            <input asp-for="OrderIndex" type="number" class="form-control" min="1" required />
                        </div>
                    </div>

                    <div class="mb-3 p-3 bg-light rounded border">
                        <label class="form-label fw-semibold"><i class="bi bi-image me-1"></i>Slider Görseli</label>
                        
                        @if (!string.IsNullOrEmpty(Model.ExistingImageUrl))
                        {
                            <div class="d-flex align-items-center gap-3 mb-2 p-2 bg-white rounded border">
                                <img src="@Model.ExistingImageUrl" alt="Mevcut Görsel" 
                                     class="img-thumbnail rounded shadow-sm" style="max-height: 80px; max-width: 150px; object-fit: cover;"
                                     onerror="this.src='https://placehold.co/150x80?text=No+Img';" />
                                <div>
                                    <span class="small text-muted d-block">Mevcut Görsel Yolu:</span>
                                    <code class="small text-dark">@Model.ExistingImageUrl</code>
                                </div>
                            </div>
                            <div class="form-check mb-3">
                                <input asp-for="RemoveExistingImage" class="form-check-input" type="checkbox" id="chkRemoveExistingImg" />
                                <label class="form-check-label text-danger small fw-semibold" for="chkRemoveExistingImg">
                                    <i class="bi bi-trash3 me-1"></i>Mevcut görseli sil / kaldır (Görselsiz metin banner'ı olarak göster)
                                </label>
                            </div>
                        }

                        <label class="form-label small text-muted">Görseli Değiştirmek İsterseniz Yeni Dosya Seçin:</label>
                        <input type="file" name="imageFile" class="form-control" accept="image/*" />
                        <small class="text-muted">Yeni dosya seçilmezse mevcut görsel korunur. Yeni dosya seçildiğinde eskisinin yerine kaydedilir.</small>
                    </div>

                    <div class="form-check form-switch mb-4">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
                        <label asp-for="IsActive" class="form-check-label fw-semibold">Slider ana sayfada aktif olarak görüntülensin</label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-bold">
                        <i class="bi bi-save me-1"></i>Değişiklikleri Kaydet
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
