@model List<C1Soft.Business.DTOs.Banner.BannerDto>
@{
    ViewData["Title"] = "Admin - Slider / Banner Yönetimi";
}

<div class="row align-items-center mb-4">
    <div class="col-md-7 mb-3 mb-md-0">
        <h2 class="fw-bold text-dark mb-1">
            <i class="bi bi-images text-warning me-2"></i>Slider & Banner Yönetimi
        </h2>
        <p class="text-muted small mb-0">
            Ana sayfa carousel alanındaki kampanya ve duyuru slider içeriklerini yönetebilir, sıralayabilir ve görsel yükleyebilirsiniz (Madde 4.1).
        </p>
    </div>
    <div class="col-md-5 text-md-end">
        <a asp-action="BannerCreate" class="btn btn-success px-3 shadow-sm">
            <i class="bi bi-plus-circle me-1"></i>Yeni Slider Ekle
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-1"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-octagon me-1"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th style="width: 80px;" class="text-center">Sıra</th>
                    <th style="width: 100px;">Görsel</th>
                    <th>Slider Başlığı</th>
                    <th>Açıklama / Alt Başlık</th>
                    <th>Hedef Link</th>
                    <th class="text-center" style="width: 110px;">Durum</th>
                    <th class="text-center" style="width: 230px;">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-images fs-1 d-block mb-2"></i>
                            Henüz tanımlı bir slider/banner içeriği bulunmamaktadır.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var banner in Model)
                    {
                        <tr>
                            <td class="text-center">
                                <span class="badge bg-secondary fs-6">@banner.OrderIndex</span>
                            </td>
                            <td>
                                <img src="@(string.IsNullOrEmpty(banner.ImageUrl) ? "https://placehold.co/100x50?text=No+Img" : banner.ImageUrl)"
                                     class="img-thumbnail rounded shadow-sm"
                                     style="width: 90px; height: 50px; object-fit: cover;"
                                     alt="@banner.Title"
                                     onerror="this.src='https://placehold.co/100x50?text=No+Img';" />
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@banner.Title</div>
                                <small class="text-muted">Kayıt: @banner.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</small>
                            </td>
                            <td>
                                <span class="text-muted small">
                                    @(string.IsNullOrEmpty(banner.Subtitle) ? "-" : (banner.Subtitle.Length > 60 ? banner.Subtitle.Substring(0, 60) + "..." : banner.Subtitle))
                                </span>
                            </td>
                            <td>
                                <code>@(string.IsNullOrEmpty(banner.RedirectUrl) ? "/Product/Index" : banner.RedirectUrl)</code>
                            </td>
                            <td class="text-center">
                                @if (banner.IsActive)
                                {
                                    <span class="badge bg-success px-2 py-1">
                                        <i class="bi bi-check-circle me-1"></i>Aktif
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary px-2 py-1">
                                        <i class="bi bi-dash-circle me-1"></i>Pasif
                                    </span>
                                }
                            </td>
                            <td class="text-center text-nowrap">
                                <div class="d-inline-flex gap-1 align-items-center justify-content-center">
                                    <form asp-action="BannerToggleStatus" asp-route-id="@banner.Id" method="post" class="d-inline m-0">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-@(banner.IsActive ? "warning" : "success") d-inline-flex align-items-center" 
                                                title="@(banner.IsActive ? "Pasife Al (Yayından Kaldır)" : "Aktif Et (Yayına Al)")">
                                            <i class="bi bi-power me-1"></i>@(banner.IsActive ? "Kapat" : "Aç")
                                        </button>
                                    </form>
                                    <a asp-action="BannerEdit" asp-route-id="@banner.Id" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center" title="Düzenle">
                                        <i class="bi bi-pencil me-1"></i>Düzenle
                                    </a>
                                    <form asp-action="BannerDelete" asp-route-id="@banner.Id" method="post" class="d-inline m-0"
                                          onsubmit="return confirm('Bu slider içeriğini ve yüklenmiş görselini silmek istediğinizden emin misiniz?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger d-inline-flex align-items-center" title="Sil">
                                            <i class="bi bi-trash me-1"></i>Sil
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
