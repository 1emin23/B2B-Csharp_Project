@model List<C1Soft.Business.DTOs.User.UserListDto>
@using C1Soft.Domain.Enums
@{
    ViewData["Title"] = "Admin - Bayi & Kullanıcı Yönetimi";
    var search = ViewBag.SearchQuery as string;
}

<div class="row align-items-center mb-4">
    <div class="col-md-6 mb-3 mb-md-0">
        <h2 class="fw-bold text-dark mb-1">
            <i class="bi bi-people text-warning me-2"></i>Bayi & Kullanıcı Yönetimi
        </h2>
        <p class="text-muted small mb-0">
            Sisteme kayıtlı bayileri ve yöneticileri listeleyebilir, rol ve durumlarını düzenleyebilirsiniz.
        </p>
    </div>
    <div class="col-md-6 text-md-end">
        <span class="badge bg-secondary fs-6">Toplam @Model.Count Kullanıcı</span>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-1"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Users" class="d-flex gap-2">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="search" value="@search" class="form-control border-start-0 ps-0"
                       placeholder="Ad, soyad, kullanıcı adı veya e-posta ara..." />
                <button type="submit" class="btn btn-primary px-4">Ara</button>
            </div>
            @if (!string.IsNullOrEmpty(search))
            {
                <a asp-action="Users" class="btn btn-outline-secondary d-flex align-items-center">
                    <i class="bi bi-x-lg"></i>
                </a>
            }
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Ad Soyad</th>
                    <th>Kullanıcı Adı</th>
                    <th>E-Posta</th>
                    <th>Telefon</th>
                    <th class="text-center">Rol</th>
                    <th class="text-center">Durum</th>
                    <th class="text-center" style="width: 120px;">İşlem</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td class="fw-bold text-dark">@u.FullName</td>
                        <td><code>@u.Username</code></td>
                        <td>@u.Email</td>
                        <td>@(u.PhoneNumber ?? "-")</td>
                        <td class="text-center">
                            <span class="badge @(u.Role == UserRole.Admin ? "bg-danger" : "bg-success")">
                                @u.Role
                            </span>
                        </td>
                        <td class="text-center">
                            @if (u.IsActive)
                            {
                                <span class="badge bg-success">Aktif</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Pasif</span>
                            }
                        </td>
                        <td class="text-center">
                            <a asp-action="UserEdit" asp-route-id="@u.Id" class="btn btn-outline-primary btn-sm px-3">
                                <i class="bi bi-pencil"></i> Düzenle
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
