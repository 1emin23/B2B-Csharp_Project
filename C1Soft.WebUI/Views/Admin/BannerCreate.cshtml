@model C1Soft.Business.DTOs.Banner.BannerCreateDto
@{
    ViewData["Title"] = "Yeni Slider Ekle";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold"><i class="bi bi-plus-circle me-2"></i>Yeni Slider / Banner Ekle</h5>
                <a asp-action="Banners" class="btn btn-outline-light btn-sm">
                    <i class="bi bi-arrow-left me-1"></i>Listeye Dön
                </a>
            </div>
            <div class="card-body p-4">
                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div class="alert alert-danger" role="alert">
                        <ul class="mb-0 ps-3">
                            @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        </ul>
                    </div>
                }

                <form asp-action="BannerCreate" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold">Slider Başlığı *</label>
                        <input asp-for="Title" class="form-control" placeholder="Örn: 2026 Endüstriyel Otomasyon Kampanyası" required autofocus />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Subtitle" class="form-label fw-semibold">Alt Başlık / Açıklama Metni</label>
                        <textarea asp-for="Subtitle" rows="2" class="form-control" placeholder="Örn: Tüm Siemens ve Bosch ürünlerinde bayilere özel fırsatlar..."></textarea>
                        <span asp-validation-for="Subtitle" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-8">
                            <label asp-for="RedirectUrl" class="form-label fw-semibold">Tıklanınca Gidilecek Link (URL)</label>
                            <input asp-for="RedirectUrl" class="form-control" placeholder="/Product/Index" value="/Product/Index" />
                            <small class="text-muted">Kullanıcı slider'a tıkladığında bu adrese yönlendirilir.</small>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="OrderIndex" class="form-label fw-semibold">Gösterim Sırası *</label>
                            <input asp-for="OrderIndex" type="number" class="form-control" value="1" min="1" required />
                            <small class="text-muted">Küçük sayılar önce gösterilir.</small>
                        </div>
                    </div>

                    <div class="mb-3 p-3 bg-light rounded border">
                        <label class="form-label fw-semibold"><i class="bi bi-image me-1"></i>Slider Görseli Yükle</label>
                        <input type="file" name="imageFile" class="form-control mb-2" accept="image/*" />
                        <small class="text-muted d-block mb-2">Görsel seçildiğinde otomatik olarak sunucuya yüklenir ve dosya yolu veritabanına kaydedilir.</small>
                        
                        <div class="text-muted small">Veya alternatif doğrudan görsel URL'i:</div>
                        <input asp-for="ImageUrl" class="form-control form-control-sm mt-1" placeholder="/images/banners/ornek.jpg veya https://..." />
                    </div>

                    <div class="form-check form-switch mb-4">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" checked />
                        <label asp-for="IsActive" class="form-check-label fw-semibold">Slider hemen ana sayfada yayına alınsın (Aktif)</label>
                    </div>

                    <button type="submit" class="btn btn-success w-100 py-2 fw-bold">
                        <i class="bi bi-check-circle me-1"></i>Slider'ı Kaydet
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
