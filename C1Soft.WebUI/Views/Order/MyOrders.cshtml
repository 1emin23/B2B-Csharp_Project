@model List<C1Soft.Business.DTOs.Order.OrderSummaryDto>
@using C1Soft.Domain.Enums
@{
    ViewData["Title"] = "Sipariş Geçmişim";
}

<div class="row mb-3">
    <div class="col-12">
        <h2 class="fw-bold text-dark mb-1">
            <i class="bi bi-receipt text-primary me-2"></i>Sipariş Geçmişim
        </h2>
        <p class="text-muted small">
            Verdiğiniz tüm B2B siparişleri, onay durumları ve snapshot dökümleri bu sayfada listelenir.
        </p>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm text-center py-5">
        <div class="card-body">
            <div class="mb-3 text-muted">
                <i class="bi bi-receipt-cutoff" style="font-size: 4rem;"></i>
            </div>
            <h4 class="fw-bold text-dark">Henüz Siparişiniz Bulunmuyor</h4>
            <p class="text-muted mb-4">Ürün kataloğumuzdan hızlıca sipariş verebilirsiniz.</p>
            <a asp-controller="Product" asp-action="Index" class="btn btn-primary px-4 py-2">
                <i class="bi bi-grid-3x3-gap me-2"></i>Ürün Kataloğuna Git
            </a>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Sipariş No</th>
                        <th>Sipariş Tarihi</th>
                        <th class="text-end">Toplam Tutar</th>
                        <th class="text-center">Durum</th>
                        <th class="text-center" style="width: 120px;">İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td>
                                <code class="fw-bold text-dark fs-6">@order.OrderNumber</code>
                            </td>
                            <td>
                                <div>@order.OrderDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                                <small class="text-muted">UTC: @order.OrderDate.ToString("yyyy-MM-dd HH:mm")</small>
                            </td>
                            <td class="text-end fw-bold text-primary fs-6">
                                @order.TotalAmount.ToString("N2") ₺
                            </td>
                            <td class="text-center">
                                @switch (order.Status)
                                {
                                    case OrderStatus.Pending:
                                        <span class="badge bg-warning text-dark px-3 py-2">
                                            <i class="bi bi-clock me-1"></i>Beklemede
                                        </span>
                                        break;

                                    case OrderStatus.Approved:
                                        <span class="badge bg-success px-3 py-2">
                                            <i class="bi bi-check-circle me-1"></i>Onaylandı
                                        </span>
                                        break;

                                    case OrderStatus.Rejected:
                                        <span class="badge bg-danger px-3 py-2">
                                            <i class="bi bi-x-circle me-1"></i>Reddedildi
                                        </span>
                                        break;
                                }
                            </td>
                            <td class="text-center">
                                <a asp-action="Detail" asp-route-id="@order.Id" class="btn btn-outline-primary btn-sm px-3">
                                    <i class="bi bi-eye me-1"></i>Detay
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
