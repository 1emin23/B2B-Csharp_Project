@{
    ViewData["Title"] = "Siparişiniz Alındı";
    var orderNumber = ViewBag.OrderNumber as string;
}

<div class="row justify-content-center mt-5">
    <div class="col-md-7 text-center">
        <div class="card border-0 shadow-sm p-5">
            <div class="mb-3 text-success">
                <i class="bi bi-check-circle-fill" style="font-size: 4.5rem;"></i>
            </div>
            <h2 class="fw-bold text-dark mb-2">Siparişiniz Başarıyla Alındı!</h2>
            <p class="text-muted mb-4">
                Sipariş kaydınız oluşturulmuş ve yönetici onayına sunulmuştur. Fiyat ve ürün bilgileri dondurularak snapshot olarak saklanmıştır.
            </p>

            <div class="bg-light p-3 rounded mb-4 d-inline-block border mx-auto">
                <span class="text-muted small d-block">Sipariş Takip Numaranız</span>
                <span class="fs-4 fw-bold text-primary">@orderNumber</span>
            </div>

            <div class="d-flex justify-content-center gap-3">
                <a asp-action="MyOrders" class="btn btn-primary px-4 py-2">
                    <i class="bi bi-receipt me-1"></i>Siparişlerime Git
                </a>
                <a asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary px-4 py-2">
                    <i class="bi bi-grid-3x3-gap me-1"></i>Alışverişe Devam Et
                </a>
            </div>
        </div>
    </div>
</div>
