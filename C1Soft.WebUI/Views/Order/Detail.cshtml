@model C1Soft.Business.DTOs.Order.OrderDetailDto
@using C1Soft.Domain.Enums
@{
    ViewData["Title"] = $"Sipariş Detayı - {Model.OrderNumber}";
}

<div class="row mb-3 align-items-center">
    <div class="col-md-8">
        <h2 class="fw-bold text-dark mb-1">
            <i class="bi bi-receipt-cutoff text-primary me-2"></i>Sipariş Detayı & Snapshot Fatura
        </h2>
        <p class="text-muted small mb-0">
            Sipariş No: <code class="fw-bold text-dark fs-6">@Model.OrderNumber</code>
            <span class="ms-3">Tarih: <strong>@Model.OrderDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</strong></span>
        </p>
    </div>
    <div class="col-md-4 text-md-end mt-2 mt-md-0">
        <a asp-action="MyOrders" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Siparişlerime Dön
        </a>
    </div>
</div>

<!-- Snapshot Koruma Bilgilendirme Kutusu (Madde 9) -->
<div class="alert alert-info d-flex align-items-center mb-4 shadow-sm" role="alert">
    <i class="bi bi-shield-lock-fill fs-3 me-3 text-primary"></i>
    <div>
        <strong>Snapshot Veri Güvencesi (Madde 9):</strong> Aşağıdaki birim fiyatlar, ürün kodları ve ürün adları, siparişin verildiği saniyede dondurulmuştur. Sistem yöneticisi daha sonra ürünün adını veya fiyatını değiştirse bile bu faturadaki tutarlar <u>asla değişmez</u>.
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Sipariş Bilgileri Kartı -->
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-light py-3">
                <h6 class="mb-0 fw-bold"><i class="bi bi-info-circle me-2"></i>Sipariş Durumu</h6>
            </div>
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="text-muted">Onay Durumu:</span>
                    <div>
                        @switch (Model.Status)
                        {
                            case OrderStatus.Pending:
                                <span class="badge bg-warning text-dark px-3 py-2 fs-6">
                                    <i class="bi bi-clock me-1"></i>Beklemede (Yönetici Onayı Bekliyor)
                                </span>
                                break;

                            case OrderStatus.Approved:
                                <span class="badge bg-success px-3 py-2 fs-6">
                                    <i class="bi bi-check-circle me-1"></i>Onaylandı
                                </span>
                                break;

                            case OrderStatus.Rejected:
                                <span class="badge bg-danger px-3 py-2 fs-6">
                                    <i class="bi bi-x-circle me-1"></i>Reddedildi
                                </span>
                                break;
                        }
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.AdminNote))
                {
                    <div class="p-3 bg-light rounded border mt-3">
                        <span class="fw-bold small text-muted d-block mb-1">
                            <i class="bi bi-chat-left-dots me-1"></i>Yönetici Açıklama Notu:
                        </span>
                        <p class="mb-0 text-dark">@Model.AdminNote</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Tutar Özeti Kartı -->
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-light py-3">
                <h6 class="mb-0 fw-bold"><i class="bi bi-cash-stack me-2"></i>Ödeme & Tutar Özeti</h6>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Toplam Kalem:</span>
                    <strong>@Model.Items.Count Çeşit Ürün</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Toplam Sipariş Adedi:</span>
                    <strong>@Model.Items.Sum(i => i.Quantity) Adet</strong>
                </div>
                <hr />
                <div class="d-flex justify-content-between align-items-center">
                    <span class="fs-5 fw-bold text-dark">Genel Toplam:</span>
                    <span class="fs-4 fw-bold text-primary">@Model.TotalAmount.ToString("N2") ₺</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Snapshot Kalem Tablosu -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3">
        <h5 class="mb-0 fw-bold"><i class="bi bi-list-check me-2"></i>Sipariş Kalemleri (Fiyat Snapshot Kayıtları)</h5>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 65px;">Görsel</th>
                    <th>Sipariş Anındaki Ürün Kodu</th>
                    <th>Sipariş Anındaki Ürün Adı</th>
                    <th class="text-end">Dondurulan Birim Fiyat</th>
                    <th class="text-center">Sipariş Adedi</th>
                    <th class="text-end">Toplam Tutar</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>
                            <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://placehold.co/50x50?text=No+Img" : item.ImageUrl)"
                                 class="img-thumbnail rounded"
                                 style="width: 45px; height: 45px; object-fit: contain;"
                                 alt="@item.ProductName"
                                 onerror="this.src='https://placehold.co/50x50?text=No+Img';" />
                        </td>
                        <td>
                            <code class="fw-bold text-dark">@item.ProductCode</code>
                        </td>
                        <td class="fw-semibold text-dark">
                            @item.ProductName
                        </td>
                        <td class="text-end">
                            @item.UnitPrice.ToString("N2") ₺
                        </td>
                        <td class="text-center">
                            <span class="badge bg-light text-dark border px-2 py-1">@item.Quantity Adet</span>
                        </td>
                        <td class="text-end fw-bold text-primary">
                            @item.TotalPrice.ToString("N2") ₺
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot class="table-light">
                <tr>
                    <th colspan="5" class="text-end fw-bold fs-6">Genel Toplam:</th>
                    <th class="text-end fw-bold text-primary fs-6">@Model.TotalAmount.ToString("N2") ₺</th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
